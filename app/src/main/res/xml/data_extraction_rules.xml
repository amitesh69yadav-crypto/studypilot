<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12+. Downloaded AI models are large and can be re-downloaded.
     Chatbot API keys stay on this device only: not backed up, not copied to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="studypilot_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="studypilot_keys.xml" />
    </device-transfer>
</data-extraction-rules>
