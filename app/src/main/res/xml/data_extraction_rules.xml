<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12+. Downloaded AI models are large and can be re-downloaded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
